<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scara_twin</name>
  <version>0.1.0</version>
  <description>Digital twin of the SCARA (Station 5): real joint angles from the Pico shown in RViz.</description>
  <maintainer email="carlosdanielmurillomena@gmail.com">Charly</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>scara_description</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
